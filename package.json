{
  "name": "phase-pi",
  "version": "2.2.0",
  "description": "phase — Pi-native. Turns human intent into a bounded plan and drives concurrent agents through a control+data bus + atomic ticket system. Bundled Pi tools + skill; runs only in the Pi agent.",
  "type": "module",
  "license": "MIT",
  "author": "FatCitten",
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "agents",
    "orchestration",
    "coordination",
    "ticketing",
    "dag",
    "llm",
    "slm",
    "workflow"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "phase": "./bin/phase.js",
    "phase-alloc": "./bin/phase-alloc.mjs",
    "phase-worker": "./bin/phase-worker.mjs",
    "phase-schedule": "./bin/phase-schedule.mjs",
    "phase-orchestrate": "./bin/phase-orchestrate.mjs",
    "phase-chat": "./bin/phase-chat.mjs",
    "phase-chatroom": "./bin/phase-chatroom.mjs",
    "phase-bus": "./bin/phase-bus.mjs",
    "phase-reconcile": "./bin/phase-reconcile.mjs",
    "phase-taste": "./bin/phase-taste.mjs",
    "phase-role": "./bin/phase-role.mjs"
  },
  "scripts": {
    "orch": "node bin/phase-orchestrate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^20",
    "typebox": "*",
    "typescript": "^5"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "skills",
    "extensions",
    "install.sh",
    "phase",
    "README.md",
    "phase.taste.mjs"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "type": "package"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.87.1"
  }
}
