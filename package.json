  "type": "module",
  "license": "MIT",
  "author": "FatCitten",
  "keywords": [
    "isa",
    "llm",
    "agent",
    "assembly",
    "sandbox",
    "budget",
    "event-log",
    "bus"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "isa": "./isa",
    "isa-begin": "./bin/isa-begin.mjs",
    "isa-exec": "./bin/isa-exec.mjs",
    "isa-end": "./bin/isa-end.mjs",
    "isa-status": "./bin/isa-status.mjs",
    "isa-bus": "./bin/isa-bus.mjs"
  },
  "scripts": {
    "test": "node --test test/",
    "typecheck": "tsc --noEmit",
    "smoke": "bash examples/smoke-test.sh"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.18",
    "@types/node": "^22",
    "typescript": "^5"
  },
  "files": [
    "bin",
    "src",
    "skills",
