{
  "name": "isa-pro",
  "version": "0.1.0",
  "description": "ISA-PRO — the ISA: a caveman language for AI context to flow in and out. LLM as processor, tokens as bytes. Emit ROUTE / GRANT / ALLOC, clamp to ceilings, log to the bus.",
  "type": "module",
  "license": "MIT",
  "author": "FatCitten",
  "keywords": [
    "isa",
    "llm",
    "agent",
    "assembly",
    "allocation",
    "budget",
    "event-log",
    "bus"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "isa": "./isa",
    "isa-alloc": "./bin/isa-alloc.mjs",
    "isa-bus": "./bin/isa-bus.mjs"
  },
  "scripts": {
    "test": "node --test test/",
    "typecheck": "tsc --noEmit",
    "smoke": "bash examples/smoke-test.sh"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^20",
    "typebox": "*",
    "typescript": "^5"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "extensions",
    "docs",
    "isa",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "type": "package"
  }
}
