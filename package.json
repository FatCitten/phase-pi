{
  "name": "isa-pro",
  "version": "0.3.0",
  "description": "ISA-PRO — a run is confined, recorded work. The sandbox is the boundary; the bus is the log of record. Nothing is planned, nothing is budgeted, nothing is enforced beyond the sandbox and the wall limit.",
  "type": "module",
  "license": "MIT",
  "author": "FatCitten",
  "keywords": [
    "isa",
    "llm",
    "agent",
    "sandbox",
    "event-log",
    "bus",
    "record"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "isa": "./isa",
    "isa-begin": "./bin/isa-begin.mjs",
    "isa-exec": "./bin/isa-exec.mjs",
    "isa-end": "./bin/isa-end.mjs",
    "isa-status": "./bin/isa-status.mjs",
    "isa-bus": "./bin/isa-bus.mjs"
  },
  "scripts": {
    "test": "node --test test/",
    "typecheck": "tsc --noEmit",
    "smoke": "bash examples/smoke-test.sh"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.18",
    "@types/node": "^22",
    "typescript": "^5"
  },
  "files": [
    "bin",
    "src",
    "skills",
    ".opencode",
    "docs",
    "isa",
    "README.md"
  ]
}
